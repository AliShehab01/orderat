{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // server/ and src/lib/ use explicit .ts extensions on relative imports so the same files also
    // run under Deno (Supabase Edge Functions), which requires them. noEmit above satisfies the
    // TS5096 requirement this option comes with.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // supabase/functions is Deno code (Deno.serve, Deno.env, npm: specifiers) with its own
  // supabase/functions/deno.json; it is not part of the Next.js/Node TypeScript project.
  "exclude": ["node_modules", "supabase"]
}
