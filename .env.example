# Copy to .env.local (gitignored) and fill in real values. See README.md for what each does —
# "WhatsApp agent" for the WHATSAPP_*/INSTAGRAM_*/GEMINI_*/OWNER_KEY settings server/dev.ts reads
# locally, "Hosting" for the ORDERAT_*-prefixed ones the hosting:* scripts and Edge Functions use.
# No values here, only names — never fill this file in and commit it.

# --- Local agent (server/dev.ts) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=
WHATSAPP_ALLOW_UNSIGNED=
WHATSAPP_DRY_RUN=
DEMO_CUSTOMER_NUMBER=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=
INSTAGRAM_REPLY_TO=
INSTAGRAM_ALLOW_UNSIGNED=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
OWNER_KEY=
# Hosted owner API only (supabase/functions/orderat-owner) — server/dev.ts's cookie-based /owner
# never needs CORS. Comma list of exact origins allowed to call it; defaults to
# https://alishehab01.github.io (the static owner page, public/orderat/owner.html) when unset.
OWNER_ALLOWED_ORIGINS=
# Hosted orderat-ask only (docs/ask-orderat.md) — server/dev.ts has no local route for it, but this
# is still unprefixed here (like GEMINI_*/OWNER_* above) so `npm run hosting:secrets` pushes it as
# ORDERAT_ASK_DAILY_CAP. Optional: defaults to 3000 (server/ask/limits.ts) when unset.
ASK_DAILY_CAP=
# Hosted orderat-studio only (docs/marketing-tools.md) — its two AI tasks' daily caps (optional:
# default 3000 for captions, 300 for photos — server/usage/feature-limits.ts) and its image model +
# fallbacks (optional: default gemini-3.1-flash-image / gemini-2.5-flash-image —
# server/studio/photo.ts). GEMINI_API_KEY above is reused for both the text and image models.
CAPTION_DAILY_CAP=
PHOTO_DAILY_CAP=
IMAGE_MODEL=
IMAGE_FALLBACK_MODELS=
# Hosted orderat-shop only (docs/marketing-tools.md). SHOP_BASE_URL is optional: defaults to
# https://alishehab01.github.io/orderat/s/? (the public shop page). SHOP_IP_SALT is optional too: when
# unset, the function derives a salt from SUPABASE_SERVICE_ROLE_KEY instead (never crashes) — see
# supabase/functions/orderat-shop/index.ts.
SHOP_BASE_URL=
SHOP_IP_SALT=
# Hosted orderat-auth only (docs/sme-phase-2-cloud.md, SME phase 2). Comma lists of the ID-token
# audiences ("aud") this project accepts. APPLE_AUDIENCES is optional: defaults to com.ams.orderat
# when unset (server/auth/providers.ts). GOOGLE_AUDIENCES has no default — until it's set, no Google
# sign-in can ever verify (its aud check simply never matches), the same "refuse, never crash" posture
# every other missing-config path in this codebase takes.
APPLE_AUDIENCES=
GOOGLE_AUDIENCES=
# Hosted orderat-parse only (docs/sme-phase-2-cloud.md's AI order entry). Optional: defaults to 5000
# (server/usage/feature-limits.ts's DEFAULT_PARSE_LIMITS) when unset. GEMINI_API_KEY above is reused
# for this too — orderat-parse calls the same server/ai/gemini.ts extractor the web/agent order
# reader uses.
PARSE_DAILY_CAP=

# --- Hosting (scripts/hosting-*.mjs; see README.md "Hosting") ---
# Already ORDERAT_-prefixed locally too: they're specific to the hosted deployment, not settings
# server/dev.ts's MemoryStore path reads (except ORDERAT_DATABASE_URL, which server/dev.ts uses to
# opt into PostgresStore instead of MemoryStore when it's set).
ORDERAT_SUPABASE_PROJECT_REF=
ORDERAT_DB_POOLER_HOST=
ORDERAT_DATABASE_URL=
